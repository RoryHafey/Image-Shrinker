; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "Apave Image Shrinker"
#define MyAppVersion "1.0"
#define MyAppPublisher "Rory Hafey"
#define MyAppURL "roryngh@hotmail.com"
#define MyAppExeName "ApaveImageShrinker.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{C27C7C4E-6624-45FE-9B14-79B2F70032ED}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
ArchitecturesInstallIn64BitMode=x64compatible
DefaultDirName={autopf}\ApaveImageShrinker
DisableDirPage=yes
UninstallDisplayIcon={app}\{#MyAppExeName}
DisableProgramGroupPage=yes
; Uncomment the following line to run in non administrative install mode (install for current user only).
;PrivilegesRequired=lowest
OutputBaseFilename=ApaveImageShrinker
SolidCompression=yes
WizardStyle=modern
SetupIconFile=D:\University\Apave\Apave Image Shrinker\Logo.ico

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "D:\University\Apave\Apave Image Shrinker\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "D:\University\Apave\Apave Image Shrinker\ApaveImageShrinker$1.class"; DestDir: "{app}"; Flags: ignoreversion
Source: "D:\University\Apave\Apave Image Shrinker\ApaveImageShrinker$2.class"; DestDir: "{app}"; Flags: ignoreversion
Source: "D:\University\Apave\Apave Image Shrinker\ApaveImageShrinker$3.class"; DestDir: "{app}"; Flags: ignoreversion
Source: "D:\University\Apave\Apave Image Shrinker\ApaveImageShrinker$4.class"; DestDir: "{app}"; Flags: ignoreversion
Source: "D:\University\Apave\Apave Image Shrinker\ApaveImageShrinker$5.class"; DestDir: "{app}"; Flags: ignoreversion
Source: "D:\University\Apave\Apave Image Shrinker\ApaveImageShrinker.class"; DestDir: "{app}"; Flags: ignoreversion
Source: "D:\University\Apave\Apave Image Shrinker\icon.png"; DestDir: "{app}"; Flags: ignoreversion
Source: "C:\Program Files\Java\jdk-21\*"; DestDir: "{app}\jdk-21"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]

; Set JAVA_HOME system-wide
Filename: "cmd.exe"; Parameters: "/C setx JAVA_HOME ""{app}\jdk-21"" /M"; \
    Flags: runhidden waituntilterminated

; Append JDK bin to system PATH
Filename: "cmd.exe"; Parameters: "/C setx PATH ""%PATH%;{app}\jdk-21\bin"" /M"; \
    Flags: runhidden waituntilterminated


